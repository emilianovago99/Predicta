APP_ENV=development
DOMAIN=
ACME_EMAIL=
JWT_SECRET=
JWT_EXPIRES_SECONDS=3600
DB_NAME=mecanimales_db
DB_USER=api_user
DB_PASSWORD=
DB_ROOT_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3307
API_BIND=127.0.0.1
API_PORT=8000
WEB_BIND=127.0.0.1
WEB_PORT=8088
CORS_ORIGINS=http://localhost:8088,http://127.0.0.1:8088,http://localhost:5173
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
